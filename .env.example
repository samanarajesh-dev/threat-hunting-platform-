# Copy to .env and change every value marked CHANGE.  Never commit .env.
# Use the latest 9.x patch of the Elastic Stack (keep Elasticsearch + Filebeat on the same version).
ELASTIC_VERSION=9.5.5
ELASTIC_PASSWORD=CHANGE-elastic-password
POSTGRES_PASSWORD=CHANGE-postgres-password

# Backend
ENVIRONMENT=dev
# REQUIRED outside dev. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-initial-admin-password

# Threat-intel providers (optional: leave blank to run offline with the local watchlist only)
VT_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# Detection loop
DETECTION_INTERVAL_SECONDS=60
CORRELATION_WINDOW_MINUTES=60

# Filebeat (only used with:  docker compose --profile collect up -d)
HOST_LABEL=lab-linux
